@model List<SocialProject.Data.Models.User>

<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="lg:flex 2xl:gap-16 gap-12 max-w-[1065px] mx-auto" id="js-oversized">
        <div class="max-w-[680px] mx-auto">
            <div class="md:max-w-[580px] mx-auto flex-1 xl:space-y-6 space-y-3">

                @if (Model != null && Model.Any())
                {
                    <div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1" style="width: 580px;">
                        <h2>Search Results</h2>
                        @foreach (var user in Model)
                        {
                            <div class="flex items-center space-x-4 border-b pb-3">
                                <img src="@(string.IsNullOrEmpty(user.ProfilePictureUrl) ? Url.Content("~/images/avatar/user.png") : Url.Content("~/"+user.ProfilePictureUrl))" class="side-list-image rounded-full" />
                                <div class="flex-1">
                                    <p class="font-semibold text-lg">@user.FullName</p>
                                    <a href="@Url.Action("Details", "Users", new { userId = user.Id })" class="text-blue-500">View Profile</a>
                                    <form action="@Url.Action("SendFriendRequest", "Friends")" method="post" class="inline">
                                        <input type="hidden" name="receiverId" value="@user.Id" />
                                        <button type="submit" class="mt-2 px-4 py-2 bg-blue-500 text-white rounded-md">Add Friend</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="bg-white rounded-xl shadow-sm md:p-4 p-2 space-y-4 text-sm font-medium border1" style="width: 580px;">
                        No users found with that name. Please try searching with a different name.
                    </div>
                }
            </div>
        </div>

        <div class="flex-1">
            <div class="lg:space-y-4 lg:pb-8 max-lg:grid sm:grid-cols-2 max-lg:gap-6">
                <div class="box p-5 px-6">
                    @await Component.InvokeAsync("SuggestedFriends")
                </div>
                <div class="box p-5 px-6 border1">
                    @await Component.InvokeAsync("Hashtags")
                </div>
            </div>
        </div>
    </div>
</main>
